  <svg viewBox="0 0 24 24" fill="#fff"><path d="M21.94 4.3a1.2 1.2 0 0 0-1.27-.18L3.3 11.1c-.86.34-.83 1.58.04 1.88l4.3 1.47 1.65 5.15c.24.74 1.2.93 1.7.33l2.4-2.86 4.43 3.26c.6.44 1.46.12 1.62-.6l3.3-14.6a1.2 1.2 0 0 0-.8-1.83zM9.6 14.2l8.1-5.2-6.5 6.1c-.2.18-.32.43-.36.7l-.27 1.96-0.97-3.56z"/></svg>
